{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../out",
      "cacheVariables": {
        "CMAKE_INTERMEDIATE_DIR_STRATEGY": "SHORT"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "Word x64 Debug",
      "inherits": "x64"
    },
    {
      "name": "x64-release",
      "displayName": "Word x64 Release",
      "inherits": "x64"
    },
    {
      "name": "linux-winelib",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchain-winelib.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-winelib-debug",
      "displayName": "Word Linux Winelib Debug",
      "inherits": "linux-winelib",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-winelib-release",
      "displayName": "Word Linux Winelib Release",
      "inherits": "linux-winelib",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "linux-winelib-debug",
      "configurePreset": "linux-winelib-debug"
    },
    {
      "name": "linux-winelib-release",
      "configurePreset": "linux-winelib-release"
    }
  ]
}
